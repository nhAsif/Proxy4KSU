#!/system/bin/sh
#FROM https://github.com/CHIZI-0618/box4magisk/blob/main/box/scripts/net.inotify

xrayhelper=/data/adb/xray/bin/xrayhelper
xrayhelper_conf=/data/adb/xray/xrayhelper.yml
mod_dir=/data/adb/modules/proxy4ksu
run_dir=/data/adb/xray/run
lock_dir=${run_dir}/net_restart.lock
events=$1

stop_when_wifi_enabled() {
    sed -n 's/^[[:space:]]*stopWhenWifi:[[:space:]]*//p' ${xrayhelper_conf} | tail -n 1 | grep -qi '^true'
}

wifi_connected() {
    ip route get 1.1.1.1 2>/dev/null | grep -Eq ' dev (wlan|wifi|swlan)[^ ]* ' && return 0
    for iface in /sys/class/net/wlan* /sys/class/net/wifi* /sys/class/net/swlan*; do
        [ -d "$iface" ] || continue
        dev=${iface##*/}
        [ "$(cat "$iface/operstate" 2>/dev/null)" = "up" ] || continue
        ip addr show dev "$dev" 2>/dev/null | grep -q 'inet ' && return 0
    done
    return 1
}

mobile_connected() {
    ip route get 1.1.1.1 2>/dev/null | grep -Eq ' dev (rmnet|ccmni|wwan|rndis|eth)[^ ]* ' && return 0
    for iface in /sys/class/net/rmnet* /sys/class/net/ccmni* /sys/class/net/wwan* /sys/class/net/rndis* /sys/class/net/eth*; do
        [ -d "$iface" ] || continue
        dev=${iface##*/}
        [ "$(cat "$iface/operstate" 2>/dev/null)" = "up" ] || continue
        ip addr show dev "$dev" 2>/dev/null | grep -q 'inet ' && return 0
    done
    return 1
}

stop_xray() {
    echo "net.inotify: $1, stopping core and proxy"
    ${xrayhelper} -c ${xrayhelper_conf} proxy disable
    ${xrayhelper} -c ${xrayhelper_conf} service stop
}

restart_xray() {
    echo "net.inotify: network changed, restarting core and proxy"
    ${xrayhelper} -c ${xrayhelper_conf} proxy disable
    ${xrayhelper} -c ${xrayhelper_conf} service restart &&
        ${xrayhelper} -c ${xrayhelper_conf} proxy enable
}

main() {
    if [ -f /data/adb/xray/manual ] || [ -f ${mod_dir}/disable ]; then
        return
    fi
    case "$events" in
        *w*) ;;
        *) return ;;
    esac
    mkdir -p ${run_dir}
    if ! mkdir ${lock_dir} 2>/dev/null; then
        return
    fi
    (
        sleep 3
        if wifi_connected; then
            if stop_when_wifi_enabled; then
                stop_xray "Wi-Fi connected"
            else
                restart_xray
            fi
        elif mobile_connected; then
            restart_xray
        else
            stop_xray "no network"
        fi
        rmdir ${lock_dir}
    ) &
}

main
